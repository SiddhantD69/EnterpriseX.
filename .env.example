# EnterpriseX Environment Configuration
# Copy this file to .env and replace the values with your local credentials.
# Never commit real secrets to the repository.
# This file is for local development only; production must set DATABASE_PASSWORD explicitly.

NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=enterprisex
DATABASE_USER=enterprisex
DATABASE_PASSWORD=change_me

# Application
APP_NAME=EnterpriseX